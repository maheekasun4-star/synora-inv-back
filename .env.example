# Hotel Inventory Backend — required environment variables
# Copy this file to .env and fill in values.
# Never commit .env to source control.

# hotel_inventory database (this app's own schema)
DATABASE_URL=mysql://user:password@host:port/hotel_inventory

# ella_pms database (shared auth — reads users table)
# If your deployment only provides one DATABASE_URL variable,
# point it to ella_pms and the app will fall back to it for auth.
ELLA_PMS_DATABASE_URL=mysql://user:password@host:port/ella_pms

# Shared JWT secret — must match Ella PMS and KOT-BOT POS
JWT_SECRET=change_me

# Port the HTTP server listens on
PORT=5002

# Node environment
NODE_ENV=production
